{
  "name": "@taskboard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/oauth2": "^8.3.2",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.7",
    "@taskboard/shared": "workspace:*",
    "drizzle-orm": "~0.44.7",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "~0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  }
}
