# Copy to .env and fill in. The server reads this file from the repo root.

DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard
PORT=4000
# Listen on all interfaces so your phone can reach it over the LAN or Tailscale.
HOST=0.0.0.0
# Where the browser reaches the app. In dev this is the Vite server.
# With the taskboard.test hosts entry (see README) use http://taskboard.test:5173.
PUBLIC_URL=http://localhost:5173

# Long random string used to sign the session cookie: `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Unfinished cards from past days move onto today at midnight in this time zone.
TIMEZONE=Europe/London

# Sign-in. AUTH_MODE=google needs the three values below.
# AUTH_MODE=dev skips sign-in entirely: only use it on your own machine.
AUTH_MODE=dev
ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub. A pull request from a branch named after a card (T-12-…) moves that card.
# Secret you also paste into each repo's webhook settings: `openssl rand -hex 32`
GITHUB_WEBHOOK_SECRET=
# Fine-grained token, read-only "Pull requests" on your repos. Turns on the
# 15-minute check that catches anything the webhook missed. Optional.
GITHUB_TOKEN=
