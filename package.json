{
  "name": "taskboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @taskboard/server --filter @taskboard/web dev",
    "build": "pnpm --filter @taskboard/web build && pnpm --filter @taskboard/server build",
    "start": "pnpm --filter @taskboard/server start",
    "db:generate": "pnpm --filter @taskboard/server db:generate",
    "db:migrate": "pnpm --filter @taskboard/server db:migrate",
    "db:seed": "pnpm --filter @taskboard/server db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
